generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Product {
  id        Int      @id @default(autoincrement())
  category  String
  name      String
  price     Int
  bg        String   @default("#e6e3de")
  imageUrl  String? // 상품 이미지 주소 (없으면 배경색만 보여줍니다)
  description String? // 상품 설명 (상품 상세 페이지에 보입니다)
  sale      String?
  position  Int      @default(0)
  createdAt DateTime @default(now())
  orderItems OrderItem[]
  cartItems  CartItem[]
  wishlist   WishlistItem[]
  stocks     ProductStock[]
  reviews    Review[]

  @@unique([category, name])
  @@index([category, position])
}

// 회원 (회원가입 화면의 입력 항목과 맞춰 두었습니다)
model User {
  id             Int      @id @default(autoincrement())
  loginId        String   @unique // 아이디
  passwordHash   String // 비밀번호는 원문이 아니라 bcrypt 같은 방식으로 암호화한 값만 저장합니다
  name           String
  email          String   @unique
  phone          String
  role           String   @default("USER") // USER 일반 회원 / ADMIN 관리자
  marketingOptIn Boolean  @default(false) // [선택] 마케팅 정보 수신 동의
  termsAgreedAt  DateTime // [필수] 이용약관·개인정보 수집 동의 시각
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  sessions       Session[]
  orders         Order[]
  cartItems      CartItem[]
  wishlist       WishlistItem[]
  reviews        Review[]
  questions      Question[]
  claims         Claim[]
  userCoupons    UserCoupon[]
  pointLogs      PointLog[]
  resets         PasswordReset[]
}

// 로그인 상태 (브라우저 쿠키에 id를 저장하고, 이 테이블에서 확인합니다)
model Session {
  id        String   @id @default(cuid())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// 주문 (결제 한 번 = 한 줄). 받는 사람·금액 등은 주문 당시 값을 그대로 저장합니다.
model Order {
  id             Int         @id @default(autoincrement())
  orderNumber    String      @unique // 화면에 보여줄 주문번호
  userId         Int
  user           User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  status         String      @default("PENDING") // PENDING 접수 / PAID 결제 완료 / PREPARING 배송 준비 / SHIPPING 배송 중 / DELIVERED 배송 완료 / CANCELED 취소
  paymentMethod  String // 신용카드, 계좌이체, 무통장입금, 카카오페이
  itemsTotal     Int // 상품금액 합계
  shippingFee    Int         @default(0)
  discount       Int         @default(0)
  total          Int // 최종 결제 금액
  ordererName    String // 주문자
  ordererPhone   String
  ordererEmail   String
  recipientName  String // 받는 사람
  recipientPhone String
  address        String
  addressDetail  String?
  deliveryMemo   String?
  pointsUsed     Int         @default(0) // 사용한 적립금
  userCouponId   Int? // 사용한 쿠폰 (취소하면 되돌려 줍니다)
  claims         Claim[]
  carrier        String? // 택배사
  trackingNumber String? // 운송장 번호
  items          OrderItem[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([userId, createdAt])
}

// 주문에 담긴 상품 (상품 하나 = 한 줄). 상품이 나중에 바뀌어도 주문 내역은 그대로 남도록 이름·가격을 복사해 둡니다.
model OrderItem {
  id        Int      @id @default(autoincrement())
  orderId   Int
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId Int?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  name      String
  price     Int // 구매 당시 한 개 가격
  quantity  Int      @default(1)
  color     String?
  size      String?

  @@index([orderId])
}

// 상품 이미지 파일 (DB에 직접 저장). 상품의 imageUrl에는 "/api/product-image/이미지번호" 주소가 들어갑니다.
model ProductImage {
  id        String   @id @default(cuid())
  mime      String // image/jpeg, image/png, image/webp, image/gif
  size      Int // 바이트
  data      Bytes
  createdAt DateTime @default(now())
}

// 장바구니 (로그인한 회원별). 같은 상품이라도 사이즈가 다르면 다른 줄입니다.
model CartItem {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  size      String   @default("M")
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId, size])
  @@index([userId])
}

// 관심 상품 (로그인한 회원별)
model WishlistItem {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
}

// 사이즈별 재고. 행이 있는 사이즈만 재고를 관리하고, 행이 없는 사이즈는 무제한입니다. (quantity 0 = 품절)
model ProductStock {
  id        Int     @id @default(autoincrement())
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  size      String
  quantity  Int     @default(0)

  @@unique([productId, size])
}

// 구매 후기 (상품을 구매한 회원만, 상품당 1개)
model Review {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  rating    Int // 1~5
  content   String
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([productId, createdAt])
}

// 문의 게시판 (관리자가 답변을 남깁니다)
model Question {
  id         Int       @id @default(autoincrement())
  userId     Int
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   String // 상품 문의, 배송 문의, 교환/반품, 기타
  title      String
  content    String
  secret     Boolean   @default(false)
  answer     String?
  answeredAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([createdAt])
}

// 공지사항
model Notice {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
}

// 취소·반품·교환 신청
model Claim {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId   Int
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type      String // CANCEL 취소 / RETURN 반품 / EXCHANGE 교환
  reason    String
  status    String   @default("RECEIVED") // RECEIVED 접수 / PROCESSING 처리 중 / DONE 완료 / REJECTED 거절
  adminNote String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([orderId])
}

// 쿠폰 (관리자가 만들고, 회원이 쿠폰 번호로 등록합니다)
model Coupon {
  id        Int          @id @default(autoincrement())
  code      String       @unique
  name      String
  kind      String // PERCENT 정률(%) / AMOUNT 정액(원)
  value     Int
  minOrder  Int          @default(0)
  expiresAt DateTime?
  active    Boolean      @default(true)
  createdAt DateTime     @default(now())
  users     UserCoupon[]
}

model UserCoupon {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  couponId  Int
  coupon    Coupon    @relation(fields: [couponId], references: [id], onDelete: Cascade)
  usedAt    DateTime?
  orderId   Int?
  createdAt DateTime  @default(now())

  @@unique([userId, couponId])
}

// 적립금 내역 (+ 적립, − 사용·회수). 잔액은 합계입니다.
model PointLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Int
  reason    String
  orderId   Int?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// 비밀번호 재설정 (이메일로 보낸 링크의 토큰을 해시해서 저장)
model PasswordReset {
  id        String    @id @default(cuid())
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}
