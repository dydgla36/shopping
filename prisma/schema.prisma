generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Product {
  id        Int      @id @default(autoincrement())
  category  String
  name      String
  price     Int
  bg        String   @default("#e6e3de")
  imageUrl  String? // 상품 이미지 주소 (없으면 배경색만 보여줍니다)
  description String? // 상품 설명 (상품 상세 페이지에 보입니다)
  sale      String?
  position  Int      @default(0)
  createdAt DateTime @default(now())
  orderItems OrderItem[]

  @@unique([category, name])
  @@index([category, position])
}

// 회원 (회원가입 화면의 입력 항목과 맞춰 두었습니다)
model User {
  id             Int      @id @default(autoincrement())
  loginId        String   @unique // 아이디
  passwordHash   String // 비밀번호는 원문이 아니라 bcrypt 같은 방식으로 암호화한 값만 저장합니다
  name           String
  email          String   @unique
  phone          String
  role           String   @default("USER") // USER 일반 회원 / ADMIN 관리자
  marketingOptIn Boolean  @default(false) // [선택] 마케팅 정보 수신 동의
  termsAgreedAt  DateTime // [필수] 이용약관·개인정보 수집 동의 시각
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  sessions       Session[]
  orders         Order[]
}

// 로그인 상태 (브라우저 쿠키에 id를 저장하고, 이 테이블에서 확인합니다)
model Session {
  id        String   @id @default(cuid())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// 주문 (결제 한 번 = 한 줄). 받는 사람·금액 등은 주문 당시 값을 그대로 저장합니다.
model Order {
  id             Int         @id @default(autoincrement())
  orderNumber    String      @unique // 화면에 보여줄 주문번호
  userId         Int
  user           User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  status         String      @default("PENDING") // PENDING 접수 / PAID 결제 완료 / PREPARING 배송 준비 / SHIPPING 배송 중 / DELIVERED 배송 완료 / CANCELED 취소
  paymentMethod  String // 신용카드, 계좌이체, 무통장입금, 카카오페이
  itemsTotal     Int // 상품금액 합계
  shippingFee    Int         @default(0)
  discount       Int         @default(0)
  total          Int // 최종 결제 금액
  ordererName    String // 주문자
  ordererPhone   String
  ordererEmail   String
  recipientName  String // 받는 사람
  recipientPhone String
  address        String
  addressDetail  String?
  deliveryMemo   String?
  carrier        String? // 택배사
  trackingNumber String? // 운송장 번호
  items          OrderItem[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([userId, createdAt])
}

// 주문에 담긴 상품 (상품 하나 = 한 줄). 상품이 나중에 바뀌어도 주문 내역은 그대로 남도록 이름·가격을 복사해 둡니다.
model OrderItem {
  id        Int      @id @default(autoincrement())
  orderId   Int
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId Int?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  name      String
  price     Int // 구매 당시 한 개 가격
  quantity  Int      @default(1)
  color     String?
  size      String?

  @@index([orderId])
}
